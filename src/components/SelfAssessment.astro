---
import { site } from "@data/site";

type AssessmentParagraph = string;

const paragraphs = site.selfAssessment
    .paragraphs as readonly AssessmentParagraph[];
---

<section
    id="self-assessment"
    class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8"
    aria-labelledby="self-assessment-heading"
>
    <h2 id="self-assessment-heading" class="section-heading">
        Self Assessment
    </h2>
    <div class="reveal-content mt-8 grid items-start gap-10">
        <div class="space-y-8 body-copy">
            {paragraphs.map((p) => <p>{p}</p>)}
        </div>
    </div>
</section>

<style is:global>
    .reveal-content {
        opacity: 0;
        transform: translateY(20px);
        animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    @keyframes revealIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
